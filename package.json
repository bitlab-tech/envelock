{
  "name": "envelock",
  "version": "0.2.0",
  "description": "Framework-agnostic envelope encryption for Browser with pluggable KDF strategies.",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitlab-tech/envelock.git"
  },
  "bugs": {
    "url": "https://github.com/bitlab-tech/envelock/issues"
  },
  "homepage": "https://github.com/bitlab-tech/envelock",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./verify": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit && tsc -p test --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "envelope-encryption",
    "hkdf",
    "sha256",
    "ed25519",
    "aes-256-gcm",
    "crypto",
    "encryption"
  ],
  "author": "Son Nguyen",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20",
    "browser": ">=100"
  }
}
